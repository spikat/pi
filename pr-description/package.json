{
  "name": "@spikat/pi-pr-description",
  "version": "1.2.0",
  "description": "Generate Markdown pull request descriptions from Git branch commits in Pi",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "git",
    "pull-request"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spikat/pi.git",
    "directory": "pr-description"
  },
  "files": [
    "index.ts",
    "git.ts",
    "web-command.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "jiti": "^2.7.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
