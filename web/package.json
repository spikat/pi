{
  "name": "@spikat/pi-web",
  "version": "0.1.8",
  "description": "Local HTTPS bridge and live web dashboard for Pi sessions",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "web",
    "dashboard",
    "websocket"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spikat/pi.git",
    "directory": "web"
  },
  "files": [
    "index.ts",
    "bridge.ts",
    "core.ts",
    "runtime.ts",
    "server.mjs",
    "transport.mjs",
    "transport.d.mts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "tsx --test test/**/*.test.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "selfsigned": "^5.5.0",
    "ws": "^8.22.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
